#!/bin/bash
################################################################################
# Multi-Report-OMV
# Main Executable
# SMART monitoring and reporting for OpenMediaVault
################################################################################
#
# Table of Contents:
# 1. Environment Setup
# 2. First Run Setup
# 3. Installation Management
# 4. Core Module Loading
# 5. Help and Version
# 6. Application Commands
# 7. Privilege Management
# 8. Main Entry Point
#
################################################################################

################################################################################
# 1. ENVIRONMENT SETUP
################################################################################

# Prevent text wrapping in console output
export COLUMNS=999

# Record main script PID
export MAIN_SCRIPT_PID=$$

# Determine script location
SCRIPT_PATH="$(readlink -f "$0")"
BASE_DIR="$(dirname "$(dirname "$SCRIPT_PATH")")"

# Environment file path
ENV_FILE="$BASE_DIR/.env"

# Installation log file (stays in script directory)
INSTALL_LOG="$BASE_DIR/installation.log"

################################################################################
# 2. FIRST RUN SETUP
################################################################################

# Function to log installation events
log_install() {
    local message="$*"
    local timestamp=$(date +"%Y-%m-%d %H:%M:%S")
    echo "[$timestamp] $message" >> "$INSTALL_LOG"
}

# Function to prompt for installation type on first run
first_run_setup() {
    # Start installation log
    echo "==========================================" >> "$INSTALL_LOG"
    log_install "First Run Setup Started"
    log_install "Script location: $BASE_DIR"
    log_install "User: $(whoami)"
    log_install "Hostname: $(hostname)"
    echo "==========================================" >> "$INSTALL_LOG"
    
    echo "Multi-Report-OMV - First Run Setup"
    echo "==================================="
    echo
    echo "This appears to be your first time running Multi-Report-OMV."
    echo "Please choose where you'd like to store configuration and logs:"
    echo
    echo "1) System-wide installation (/etc/multi-report-omv, /var/log/multi-report-omv)"
    echo "   Requires root privileges, available to all users"
    echo
    echo "2) User installation (~/.config/multi-report-omv, ~/.local/share/multi-report-omv/logs)"
    echo "   User-specific settings, no root required"
    echo
    echo "3) Local installation (current directory)"
    echo "   Portable, contained within the script directory"
    echo

    # Default to local installation if running non-interactively
    if [ ! -t 0 ]; then
        echo "Non-interactive shell detected, defaulting to local installation."
        log_install "Non-interactive mode detected"
        INSTALLATION_TYPE="local"
        CONFIG_BASE="$BASE_DIR/config"
        LOG_BASE="$BASE_DIR/logs"
        TMP_BASE="$BASE_DIR/tmp"
    else
        # Prompt for installation type
        local choice
        while true; do
            read -p "Select installation type [1-3]: " choice
            case "$choice" in
                1)
                    INSTALLATION_TYPE="system"
                    CONFIG_BASE="/etc/multi-report-omv"
                    LOG_BASE="/var/log/multi-report-omv"
                    TMP_BASE="/tmp/multi-report-omv"
                    log_install "User selected: System-wide installation"
                    break
                    ;;
                2)
                    INSTALLATION_TYPE="user"
                    CONFIG_BASE="$HOME/.config/multi-report-omv"
                    LOG_BASE="$HOME/.local/share/multi-report-omv/logs"
                    TMP_BASE="$HOME/.local/share/multi-report-omv/tmp"
                    log_install "User selected: User installation"
                    break
                    ;;
                3)
                    INSTALLATION_TYPE="local"
                    CONFIG_BASE="$BASE_DIR/config"
                    LOG_BASE="$BASE_DIR/logs"
                    TMP_BASE="$BASE_DIR/tmp"
                    log_install "User selected: Local installation"
                    break
                    ;;
                *)
                    echo "Invalid choice. Please select 1, 2, or 3."
                    ;;
            esac
        done
    fi

    # Confirm selection
    echo
    echo "Selected: $INSTALLATION_TYPE installation"
    echo "  Configuration will be stored in: $CONFIG_BASE"
    echo "  Logs will be stored in: $LOG_BASE"
    echo "  Temporary files will be stored in: $TMP_BASE"
    echo
    
    log_install "Configuration directory: $CONFIG_BASE"
    log_install "Log directory: $LOG_BASE"
    log_install "Temp directory: $TMP_BASE"

    # Create directories
    if [ "$INSTALLATION_TYPE" = "system" ]; then
        if ! sudo mkdir -p "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE" 2>/dev/null; then
            echo "ERROR: Failed to create system directories. Do you have sudo privileges?"
            log_install "ERROR: Failed to create system directories"
            exit 1
        fi
        sudo chmod 755 "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE"
        log_install "System directories created with sudo"
    else
        mkdir -p "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE"
        log_install "Directories created successfully"
    fi

    # Write environment file for future runs
    cat > "$ENV_FILE" << EOF
# Multi-Report-OMV Environment Configuration
# Generated on $(date)
# DO NOT EDIT MANUALLY

INSTALLATION_TYPE="$INSTALLATION_TYPE"
CONFIG_BASE="$CONFIG_BASE"
LOG_BASE="$LOG_BASE"
TMP_BASE="$TMP_BASE"
EOF

    echo "Installation preferences saved to: $ENV_FILE"
    log_install "Environment file created: $ENV_FILE"
    echo ""

    # Create symlinks if needed
    if [ "$INSTALLATION_TYPE" = "system" ]; then
        echo "Creating system command symlink..."
        if sudo ln -sf "$BASE_DIR/bin/multi-report-omv" "/usr/local/bin/multi-report-omv" 2>/dev/null; then
            echo "✓ Symlink created: /usr/local/bin/multi-report-omv"
            echo "  You can now run: multi-report-omv"
            log_install "System symlink created: /usr/local/bin/multi-report-omv"
        else
            echo "⚠ Failed to create symlink (may not have permissions)"
            log_install "WARNING: Failed to create system symlink"
        fi
    elif [ "$INSTALLATION_TYPE" = "user" ]; then
        echo "Creating user command symlink..."
        mkdir -p "$HOME/.local/bin"
        if ln -sf "$BASE_DIR/bin/multi-report-omv" "$HOME/.local/bin/multi-report-omv" 2>/dev/null; then
            echo "✓ Symlink created: ~/.local/bin/multi-report-omv"
            echo "  Ensure ~/.local/bin is in your PATH"
            echo "  You can now run: multi-report-omv"
            log_install "User symlink created: ~/.local/bin/multi-report-omv"
        else
            echo "⚠ Failed to create symlink"
            log_install "WARNING: Failed to create user symlink"
        fi
    else
        log_install "Local installation - no symlink created"
    fi

    echo
    echo "Setup complete. Continuing with execution..."
    log_install "First run setup completed successfully"
    log_install "=========================================="
    echo
}

# Check if this is the first run
if [ ! -f "$ENV_FILE" ]; then
    first_run_setup
else
    # Load environment configuration
    source "$ENV_FILE"
fi

# Ensure we have paths set regardless of how we got here
: "${INSTALLATION_TYPE:=local}"
: "${CONFIG_BASE:=$BASE_DIR/config}"
: "${LOG_BASE:=$BASE_DIR/logs}"
: "${TMP_BASE:=$BASE_DIR/tmp}"

# Export variables for modules
export BASE_DIR
export CONFIG_BASE
export LOG_BASE
export TMP_BASE
export INSTALLATION_TYPE

################################################################################
# 3. INSTALLATION MANAGEMENT
################################################################################

# Function to uninstall Multi-Report-OMV
uninstall_multi_report() {
    echo "Multi-Report-OMV - Uninstall"
    echo "============================"
    
    # Load environment file if it exists
    local current_type="local"
    local config_path="$BASE_DIR/config"
    local log_path="$BASE_DIR/logs"
    
    if [ -f "$ENV_FILE" ]; then
        source "$ENV_FILE"
        current_type="$INSTALLATION_TYPE"
        config_path="${CONFIG_BASE:-$config_path}"
        log_path="${LOG_BASE:-$log_path}"
    fi
    
    echo "Current installation type: $current_type"
    echo "Configuration directory: $config_path"
    echo "Log directory: $log_path"
    echo
    
    # Ask what to remove
    echo "What would you like to remove?"
    echo "1) Installation preferences only (keep configuration and logs)"
    echo "2) Everything (complete removal including configuration and logs)"
    echo
    
    local remove_choice
    local remove_all=false
    
    while true; do
        read -p "Select option [1-2]: " remove_choice
        case "$remove_choice" in
            1)
                remove_all=false
                break
                ;;
            2)
                remove_all=true
                break
                ;;
            *)
                echo "Invalid choice. Please select 1 or 2."
                ;;
        esac
    done
    
    echo
    if [ "$remove_all" = true ]; then
        echo "Will remove ALL data including configuration and logs."
    else
        echo "Will remove only installation preferences, keeping configuration and logs."
    fi
    echo
    
    # Confirm uninstall
    read -p "Are you sure you want to continue? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy] ]]; then
        echo "Uninstall cancelled."
        exit 0
    fi
    
    # Remove symlinks if they exist
    case "$current_type" in
        "system")
            if [ -L "/usr/local/bin/multi-report-omv" ]; then
                echo "Removing system symlink"
                sudo rm -f "/usr/local/bin/multi-report-omv"
            fi
            ;;
        "user")
            if [ -L "$HOME/.local/bin/multi-report-omv" ]; then
                echo "Removing user symlink"
                rm -f "$HOME/.local/bin/multi-report-omv"
            fi
            ;;
    esac
    
    # Remove configuration and logs if remove_all is true
    if [ "$remove_all" = true ]; then
        if [ -d "$config_path" ]; then
            echo "Removing configuration directory: $config_path"
            if [ "$current_type" = "system" ]; then
                sudo rm -rf "$config_path"
            else
                rm -rf "$config_path"
            fi
        fi
        
        if [ -d "$log_path" ]; then
            echo "Removing log directory: $log_path"
            if [ "$current_type" = "system" ]; then
                sudo rm -rf "$log_path"
            else
                rm -rf "$log_path"
            fi
        fi
        
        echo "All data has been removed."
    fi
    
    # Always remove the .env file
    if [ -f "$ENV_FILE" ]; then
        echo "Removing environment file"
        rm -f "$ENV_FILE"
    fi
    
    echo
    echo "Uninstall complete."
    echo
    echo "To reinstall, run: $BASE_DIR/bin/multi-report-omv"
    
    exit 0
}

# Function to reinstall Multi-Report-OMV
reinstall_multi_report() {
    # Log reinstall start
    echo "==========================================" >> "$INSTALL_LOG"
    log_install "Reinstall Started"
    log_install "User: $(whoami)"
    log_install "Hostname: $(hostname)"
    
    echo "Multi-Report-OMV - Reinstall"
    echo "============================"
    
    # Load current installation info if available
    local old_type="local"
    local old_config_path="$BASE_DIR/config"
    local old_log_path="$BASE_DIR/logs"
    local old_tmp_path="$BASE_DIR/tmp"
    
    if [ -f "$ENV_FILE" ]; then
        source "$ENV_FILE"
        old_type="$INSTALLATION_TYPE"
        old_config_path="${CONFIG_BASE:-$old_config_path}"
        old_log_path="${LOG_BASE:-$old_log_path}"
        old_tmp_path="${TMP_BASE:-$old_tmp_path}"
    fi
    
    log_install "Current installation type: $old_type"
    log_install "Current config: $old_config_path"
    log_install "Current logs: $old_log_path"
    
    echo "Current installation type: $old_type"
    echo "Current configuration: $old_config_path"
    echo "Current logs: $old_log_path"
    echo "Current temp directory: $old_tmp_path"
    echo
    
    # Ask if user wants to keep data
    local keep_data=true
    read -p "Do you want to migrate your existing configuration and logs? [Y/n]: " migrate_choice
    if [[ "$migrate_choice" =~ ^[Nn] ]]; then
        keep_data=false
        echo "Will perform a fresh installation without migrating data."
    else
        echo "Will migrate existing configuration and logs to the new location."
    fi
    echo
    
    # Choose new installation type
    echo "Please choose a new installation type:"
    echo "1) System-wide installation (/etc/multi-report-omv, /var/log/multi-report-omv)"
    echo "   Requires root privileges, available to all users"
    echo
    echo "2) User installation (~/.config/multi-report-omv, ~/.local/share/multi-report-omv)"
    echo "   User-specific settings, no root required"
    echo
    echo "3) Local installation (current directory)"
    echo "   Portable, contained within the script directory"
    echo
    
    local choice
    while true; do
        read -p "Select installation type [1-3]: " choice
        case "$choice" in
            1)
                INSTALLATION_TYPE="system"
                CONFIG_BASE="/etc/multi-report-omv"
                LOG_BASE="/var/log/multi-report-omv"
                TMP_BASE="/tmp/multi-report-omv"
                break
                ;;
            2)
                INSTALLATION_TYPE="user"
                CONFIG_BASE="$HOME/.config/multi-report-omv"
                LOG_BASE="$HOME/.local/share/multi-report-omv/logs"
                TMP_BASE="$HOME/.local/share/multi-report-omv/tmp"
                break
                ;;
            3)
                INSTALLATION_TYPE="local"
                CONFIG_BASE="$BASE_DIR/config"
                LOG_BASE="$BASE_DIR/logs"
                TMP_BASE="$BASE_DIR/tmp"
                break
                ;;
            *)
                echo "Invalid choice. Please select 1, 2, or 3."
                ;;
        esac
    done
    
    # Confirm selection
    echo
    echo "New installation type: $INSTALLATION_TYPE"
    echo "New configuration path: $CONFIG_BASE"
    echo "New log path: $LOG_BASE"
    echo
    
    if [ "$keep_data" = true ] && [ -d "$old_config_path" ]; then
        echo "Will migrate existing configuration and logs."
    fi
    
    read -p "Continue with reinstallation? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy] ]]; then
        echo "Reinstall cancelled."
        exit 0
    fi
    
    # Create automatic backup before reinstall
    if [ -f "$old_config_path/multi-report-omv.conf" ]; then
        echo
        echo "Creating automatic backup before reinstall..."
        # Source config module temporarily with old paths
        local saved_config_base="$CONFIG_BASE"
        CONFIG_BASE="$old_config_path"
        
        # Initialize logging temporarily
        source "${BASE_DIR}/core/logger.sh"
        init_logging 2>/dev/null || true
        
        # Create backup
        source "${BASE_DIR}/core/config.sh"
        backup_config "pre-reinstall backup" 2>/dev/null || echo "Note: Could not create backup (may not be critical)"
        
        CONFIG_BASE="$saved_config_base"
    fi
    
    # Create new directories
    if [ "$INSTALLATION_TYPE" = "system" ]; then
        sudo mkdir -p "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE"
        sudo chmod 755 "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE"
    else
        mkdir -p "$CONFIG_BASE" "$LOG_BASE" "$TMP_BASE"
    fi
    
    # Migrate configuration files
    if [ "$keep_data" = true ] && [ -d "$old_config_path" ] && [ "$old_config_path" != "$CONFIG_BASE" ]; then
        echo "Migrating configuration from $old_config_path to $CONFIG_BASE"
        if [ "$INSTALLATION_TYPE" = "system" ]; then
            sudo cp -r "$old_config_path"/* "$CONFIG_BASE"/ 2>/dev/null || true
        else
            cp -r "$old_config_path"/* "$CONFIG_BASE"/ 2>/dev/null || true
        fi
    fi
    
    # Migrate log files
    if [ "$keep_data" = true ] && [ -d "$old_log_path" ] && [ "$old_log_path" != "$LOG_BASE" ]; then
        echo "Migrating logs from $old_log_path to $LOG_BASE"
        if [ "$INSTALLATION_TYPE" = "system" ]; then
            sudo cp -r "$old_log_path"/* "$LOG_BASE"/ 2>/dev/null || true
        else
            cp -r "$old_log_path"/* "$LOG_BASE"/ 2>/dev/null || true
        fi
    fi
    
    # Write new environment file
    cat > "$ENV_FILE" << EOF
# Multi-Report-OMV Environment Configuration
# Generated on $(date)
# DO NOT EDIT MANUALLY

INSTALLATION_TYPE="$INSTALLATION_TYPE"
CONFIG_BASE="$CONFIG_BASE"
LOG_BASE="$LOG_BASE"
TMP_BASE="$TMP_BASE"
EOF
    
    # Create symlinks if needed
    if [ "$INSTALLATION_TYPE" = "system" ]; then
        echo "Creating system command symlink"
        sudo ln -sf "$BASE_DIR/bin/multi-report-omv" "/usr/local/bin/multi-report-omv"
        echo "✓ You can now run: multi-report-omv"
    elif [ "$INSTALLATION_TYPE" = "user" ]; then
        echo "Creating user command symlink"
        mkdir -p "$HOME/.local/bin"
        ln -sf "$BASE_DIR/bin/multi-report-omv" "$HOME/.local/bin/multi-report-omv"
        echo "✓ You can now run: multi-report-omv"
        echo "  Ensure ~/.local/bin is in your PATH"
    fi
    
    # Remove old symlinks if type changed
    if [ "$old_type" != "$INSTALLATION_TYPE" ]; then
        case "$old_type" in
            "system")
                if [ -L "/usr/local/bin/multi-report-omv" ]; then
                    echo "Removing old system symlink"
                    sudo rm -f "/usr/local/bin/multi-report-omv"
                fi
                ;;
            "user")
                if [ -L "$HOME/.local/bin/multi-report-omv" ]; then
                    echo "Removing old user symlink"
                    rm -f "$HOME/.local/bin/multi-report-omv"
                fi
                ;;
        esac
    fi
    
    echo
    echo "Reinstall complete."
    echo
    echo "To run Multi-Report-OMV, use: multi-report-omv (if symlinked) or $BASE_DIR/bin/multi-report-omv"
    
    exit 0
}

################################################################################
# 4. CORE MODULE LOADING
################################################################################

# Import core modules
source "${BASE_DIR}/core/logger.sh"
source "${BASE_DIR}/core/utils.sh"
source "${BASE_DIR}/core/config.sh"
source "${BASE_DIR}/core/config-backup.sh"
source "${BASE_DIR}/core/config-migration.sh"
source "${BASE_DIR}/core/notification.sh"
source "${BASE_DIR}/core/plugin.sh"

# Note: Logging initialization is delayed until we know we need it
# This prevents creating empty log files for simple commands like --help or --version

# Check if root is required (AFTER modules loaded)
if [ "$(get_config "REQUIRE_ROOT" "false")" = "true" ] && ! is_root; then
    echo "ERROR: This script must be run as root when REQUIRE_ROOT is enabled."
    echo "Please run with sudo or as the root user."
    exit 1
fi

# Define elevate_privileges function for use by commands
elevate_privileges() {
    # Skip if already root
    if is_root; then
        return 0
    fi
    
    # Check if sudo is disabled
    if [ "$(get_config "DISABLE_SUDO" "false")" = "true" ]; then
        log_error "Root privileges required but sudo is disabled in configuration"
        echo "ERROR: Root privileges required. Please run as root or enable sudo."
        return 1
    fi
    
    # Initialize sudo keepalive if not already done
    if [ "${SUDO_PRIVILEGES_INITIALIZED:-false}" != "true" ]; then
        init_sudo_privileges
        if [ $? -ne 0 ]; then
            echo "ERROR: Failed to obtain required privileges."
            return 1
        fi
    fi
    
    return 0
}

# Application info
APP_NAME="Multi-Report-OMV"
APP_VERSION=$(get_version 2>/dev/null || echo "Unknown Version")

################################################################################
# 5. HELP AND VERSION
################################################################################

show_version() {
    local simple=false
    if [ "$1" = "--simple" ] || [ "$1" = "-s" ]; then
        simple=true
    fi
    
    echo "${APP_NAME} v${APP_VERSION}"
    echo "SMART monitoring and reporting for OpenMediaVault"
    
    if [ "$simple" = false ]; then
        echo ""
        echo "Build Information:"
        # Check for git in BASE_DIR or parent directory (project root)
        local git_dir=""
        if [ -d "${BASE_DIR}/.git" ]; then
            git_dir="${BASE_DIR}"
        elif [ -d "$(dirname "${BASE_DIR}")/.git" ]; then
            git_dir="$(dirname "${BASE_DIR}")"
        fi
        
        if command -v git >/dev/null 2>&1 && [ -n "$git_dir" ]; then
            local git_hash=$(git -C "$git_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            local git_branch=$(git -C "$git_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
            local git_date=$(git -C "$git_dir" log -1 --format=%ci 2>/dev/null || echo "unknown")
            echo "  Commit: ${git_hash}"
            echo "  Branch: ${git_branch}"
            echo "  Date: ${git_date}"
        else
            echo "  Git info: not available"
        fi
        
        echo ""
        echo "Installation:"
        echo "  Type: ${INSTALLATION_TYPE:-unknown}"
        echo "  Location: ${BASE_DIR}"
        echo "  Config: ${CONFIG_BASE:-unknown}"
        echo "  Logs: ${LOG_BASE:-unknown}"
        echo "  Temp: ${TMP_BASE:-unknown}"
        
        # Show symlink status
        if [ "$INSTALLATION_TYPE" = "system" ] && [ -L "/usr/local/bin/multi-report-omv" ]; then
            echo "  Command: multi-report-omv (system-wide)"
        elif [ "$INSTALLATION_TYPE" = "user" ] && [ -L "$HOME/.local/bin/multi-report-omv" ]; then
            echo "  Command: multi-report-omv (user)"
        else
            echo "  Command: $BASE_DIR/bin/multi-report-omv"
        fi
    fi
}

show_help() {
    show_version
    echo ""
    echo "Usage: $(basename "$0") [command] [options]"
    echo ""
    echo "Commands:"
    echo "  auto             Run all enabled plugins automatically"
    echo "  status           Show system status and SMART drives"
    echo "  test             Run drive self-tests"
    echo "  report           Generate comprehensive report"
    echo "  config           Manage configuration (show, backup, restore, list-backups, clean)"
    echo ""
    echo "Plugin Commands:"
    echo "  (plugins will be listed here once installed)"
    echo ""
    echo "Installation Management:"
    echo "  --reinstall      Change installation type (system, user, or local)"
    echo "  --uninstall      Remove Multi-Report-OMV and optionally delete configuration"
    echo ""
    echo "Options:"
    echo "  --help, -h       Show this help message"
    echo "  --version, -v    Show version information"
    echo "  --debug          Enable debug logging"
    echo "  --config FILE    Use specific configuration file"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") status                # Show system status"
    echo "  $(basename "$0") test                  # Run scheduled tests"
    echo "  $(basename "$0") config show           # Show configuration"
    echo "  $(basename "$0") config backup         # Backup configuration"
    echo "  $(basename "$0") config list-backups   # List backups"
    echo "  $(basename "$0") config restore        # Restore from backup"
    echo "  $(basename "$0") --reinstall           # Change installation type"
    echo "  $(basename "$0") --uninstall           # Remove installation"
    echo "  $(basename "$0") --debug status        # Debug mode"
    echo ""
    echo "Installation Types:"
    echo "  • System-wide: /etc/multi-report-omv, /var/log/multi-report-omv (requires root)"
    echo "  • User: ~/.config/multi-report-omv, ~/.local/share/multi-report-omv (no root)"
    echo "  • Local: config/, logs/ in script directory (portable)"
    echo ""
    echo "For more information, see: ${BASE_DIR}/docs/README.md"
}

################################################################################
# 6. APPLICATION COMMANDS
################################################################################

init_app() {
    log_info "Initializing $(get_full_version)"
    
    # Load configuration
    load_config
    
    # Validate system
    if ! validate_system; then
        log_error "System validation failed"
        return 1
    fi
    
    # Initialize temporary directory
    if ! init_temp_dir; then
        log_error "Failed to initialize temporary directory"
        return 1
    fi
    
    # Initialize plugin system
    if ! init_plugins; then
        log_error "Failed to initialize plugin system"
        return 1
    fi
    
    # Export environment
    export_environment
    
    log_info "Initialization complete"
    return 0
}

cmd_status() {
    log_info "Running status check"
    
    # Get SMART drives
    local smart_drives=$(get_smart_drives)
    local drive_count=$(echo "$smart_drives" | wc -w)
    
    echo ""
    echo "=== System Status ==="
    echo "OMV Version: ${OMV_VERSION:-Unknown}"
    echo "SMART Drives: $drive_count"
    echo ""
    
    for drive in $smart_drives; do
        echo "Drive: /dev/$drive"
        smartctl -H "/dev/$drive" 2>/dev/null | grep -i "overall"
    done
    
    echo ""
    log_info "Status check complete"
}

cmd_test() {
    local test_type="${1:-help}"
    
    case "$test_type" in
        help|--help)
            echo "Test Commands:"
            echo "  test email      Send a test email notification"
            echo "  test drives     Test drive detection"
            echo "  test config     Test configuration loading"
            echo ""
            echo "Usage: multi-report-omv test <type>"
            ;;
        email)
            log_info "Testing email notification"
            echo "Testing email notification..."
            echo ""
            
            # Check if email is enabled
            if [ "$(get_config "EMAIL_ENABLED" "false")" != "true" ]; then
                echo "ERROR: Email is not enabled in configuration"
                echo "Please set EMAIL_ENABLED=true in your config file"
                return 1
            fi
            
            # Check if EMAIL_TO is configured
            if [ -z "$(get_config "EMAIL_TO")" ]; then
                echo "ERROR: EMAIL_TO is not configured"
                echo "Please set EMAIL_TO=your@email.com in your config file"
                return 1
            fi
            
            # Send test email
            if type send_test_email &>/dev/null; then
                send_test_email
            else
                echo "ERROR: Email notification system not loaded"
                return 1
            fi
            ;;
        drives)
            log_info "Testing drive detection"
            echo "Testing drive detection..."
            echo ""
            local drives=$(get_smart_drives)
            if [ -z "$drives" ]; then
                echo "No SMART-capable drives found"
                return 1
            fi
            echo "Found SMART-capable drives:"
            for drive in $drives; do
                echo "  - $drive"
            done
            ;;
        config)
            log_info "Testing configuration"
            echo "Testing configuration..."
            echo ""
            echo "Configuration loaded successfully"
            echo "Config file: $USER_CONFIG"
            echo "Log level: $(get_config "LOG_LEVEL" "info")"
            echo "Email enabled: $(get_config "EMAIL_ENABLED" "false")"
            ;;
        *)
            echo "Unknown test type: $test_type"
            echo "Use 'test help' for available test types"
            return 1
            ;;
    esac
}

cmd_report() {
    log_info "Generating report"
    echo "Report generation coming soon..."
    log_info "Report complete"
}

cmd_auto() {
    log_info "Starting automated plugin execution"
    
    # Check initial drive power states
    check_drive_power_states "Initial Drive Power States (before plugins)"
    
    local enabled_plugins=()
    local has_error=0
    local combined_summary=""
    
    # Get list of enabled plugins
    for plugin in $(list_plugins); do
        if is_plugin_enabled "$plugin"; then
            enabled_plugins+=("$plugin")
            log_info "Plugin enabled: $plugin"
        else
            log_debug "Plugin disabled: $plugin"
        fi
    done
    
    if [ ${#enabled_plugins[@]} -eq 0 ]; then
        log_warning "No enabled plugins found"
        echo "No plugins are enabled. Please enable plugins in configuration."
        return 0
    fi
    
    log_info "Will execute ${#enabled_plugins[@]} plugin(s): ${enabled_plugins[*]}"
    
    # Execute each enabled plugin
    for plugin in "${enabled_plugins[@]}"; do
        echo ""
        echo "========================================" 
        echo "Executing plugin: $plugin"
        echo "========================================"
        
        if execute_plugin "$plugin"; then
            log_info "Plugin succeeded: $plugin"
        else
            local exit_code=$?
            log_error "Plugin failed: $plugin (exit code: $exit_code)"
            has_error=1
        fi
        
        # Check drive power states after each plugin
        check_drive_power_states_info "Drive Power States After: $plugin"
    done
    
    # Combine all plugin summaries
    log_info "Combining plugin summaries"
    combined_summary=$(combine_plugin_summaries)
    
    # Display combined summary
    echo ""
    echo "========================================"
    echo "SUMMARY REPORT"
    echo "========================================"
    echo ""
    echo "$combined_summary"
    echo ""
    
    if [ $has_error -eq 0 ]; then
        log_info "Automated execution completed successfully"
        return 0
    else
        log_error "Automated execution completed with errors"
        return 1
    fi
}

cmd_config() {
    local subcommand="${1:-show}"
    shift || true
    
    case "$subcommand" in
        backup)
            local reason="${1:-manual backup}"
            backup_config "$reason"
            ;;
        restore)
            local backup_file="$1"
            if [ -z "$backup_file" ]; then
                # Interactive restore
                list_config_backups
                echo
                read -p "Enter backup number to restore (or 'q' to cancel): " choice
                
                if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
                    echo "Restore cancelled."
                    return 1
                fi
                
                if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
                    echo "Invalid selection. Please enter a number."
                    return 1
                fi
                
                backup_file=$(get_backup_by_number "$choice")
                if [ -z "$backup_file" ]; then
                    echo "Invalid backup number."
                    return 1
                fi
            elif [[ "$backup_file" =~ ^[0-9]+$ ]]; then
                # Backup number provided
                backup_file=$(get_backup_by_number "$backup_file")
                if [ -z "$backup_file" ]; then
                    echo "Invalid backup number: $1"
                    return 1
                fi
            fi
            
            # Confirm restoration
            echo "Selected backup: $(basename "$backup_file")"
            read -p "Restore this backup? This will replace your current configuration. [y/N]: " confirm
            
            if [[ ! "$confirm" =~ ^[Yy] ]]; then
                echo "Restore cancelled."
                return 1
            fi
            
            restore_config "$backup_file"
            ;;
        list-backups|list)
            list_config_backups
            ;;
        info)
            local backup_file="$1"
            if [ -z "$backup_file" ]; then
                echo "Usage: $(basename "$0") config info <backup_number_or_file>"
                return 1
            fi
            
            if [[ "$backup_file" =~ ^[0-9]+$ ]]; then
                backup_file=$(get_backup_by_number "$backup_file")
                if [ -z "$backup_file" ]; then
                    echo "Invalid backup number: $1"
                    return 1
                fi
            fi
            
            show_backup_info "$backup_file"
            ;;
        clean)
            clean_all_backups
            ;;
        show|"")
            show_config
            ;;
        --help|-h|help)
            show_config_help
            ;;
        *)
            echo "Unknown config subcommand: $subcommand"
            echo "Use '$(basename "$0") config --help' for usage information"
            return 1
            ;;
    esac
}

# Show config command help
show_config_help() {
    echo "Usage: $(basename "$0") config <subcommand> [options]"
    echo ""
    echo "Manage configuration and backups."
    echo ""
    echo "Subcommands:"
    echo "  show                Show current configuration (default)"
    echo "  backup [reason]     Create a manual backup of current configuration"
    echo "  restore [file|num]  Restore configuration from backup (interactive if no file specified)"
    echo "  list-backups        List all available configuration backups"
    echo "  info <file|num>     Show detailed information about a backup"
    echo "  clean               Delete all configuration backups (with confirmation)"
    echo "  --help, -h          Show this help message"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") config show              # Show current configuration"
    echo "  $(basename "$0") config backup            # Create manual backup"
    echo "  $(basename "$0") config list-backups      # List all backups"
    echo "  $(basename "$0") config restore           # Interactive restore"
    echo "  $(basename "$0") config restore 1         # Restore backup #1"
    echo "  $(basename "$0") config info 2            # Show info for backup #2"
    echo "  $(basename "$0") config clean             # Delete all backups"
    echo ""
}

################################################################################
# 7. PRIVILEGE MANAGEMENT
################################################################################

# (Sudo and cleanup functions will follow)

cleanup() {
    log_debug "Starting cleanup"
    
    # Stop sudo keepalive process
    cleanup_sudo_keepalive
    
    # Run other cleanup handlers
    run_cleanup_handlers
    
    log_debug "Cleanup complete"
}

# Register cleanup trap
trap cleanup EXIT INT TERM

# Initialize sudo privileges and keep them alive
init_sudo_privileges() {
    # Check if already running as root
    if [ "$(id -u)" -eq 0 ]; then
        log_debug "Already running as root, no need for sudo"
        export SUDO_PRIVILEGES_INITIALIZED="true"
        return 0
    fi
    
    # Don't elevate for help/version commands
    local needs_root=true
    for arg in "$@"; do
        if [[ "$arg" == "--help" ]] || [[ "$arg" == "-h" ]] || [[ "$arg" == "--version" ]] || [[ "$arg" == "-v" ]]; then
            needs_root=false
            break
        fi
    done
    
    if [ "$needs_root" = false ]; then
        return 0
    fi
    
    # Try to obtain sudo privileges
    log_info "Root privileges required for SMART access"
    
    if ! command -v sudo >/dev/null 2>&1; then
        log_error "sudo command not found"
        echo "Error: Root privileges required but sudo not available"
        echo "Please run as root: su -c '$0 $*'"
        exit 1
    fi
    
    # Try to get sudo access with a simple command
    if ! sudo true 2>/dev/null; then
        log_error "Failed to obtain sudo privileges"
        echo "Error: Failed to obtain sudo privileges"
        echo "Please check your sudo configuration or run as root"
        exit 1
    fi
    
    log_debug "Sudo privileges confirmed"
    
    # Start background process to keep sudo token alive
    (
        while true; do
            sleep 60
            sudo -v 2>/dev/null || exit 0
        done
    ) &
    
    # Save PID of background process for cleanup
    export SUDO_KEEPALIVE_PID=$!
    log_debug "Started sudo keepalive process (PID: $SUDO_KEEPALIVE_PID)"
    export SUDO_PRIVILEGES_INITIALIZED="true"
    
    return 0
}

# Cleanup sudo keepalive when script exits
cleanup_sudo_keepalive() {
    if [ -n "$SUDO_KEEPALIVE_PID" ] && kill -0 "$SUDO_KEEPALIVE_PID" 2>/dev/null; then
        log_debug "Stopping sudo keepalive process (PID: $SUDO_KEEPALIVE_PID)"
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null
        unset SUDO_KEEPALIVE_PID
    fi
}

# Check if we need to elevate to root and do it
check_and_elevate() {
    # Initialize sudo privileges (will handle all the logic)
    init_sudo_privileges "$@"
}

################################################################################
# 8. MAIN ENTRY POINT
################################################################################

main() {
    # Handle special installation commands first (before initialization)
    case "$1" in
        --reinstall)
            reinstall_multi_report
            ;;
        --uninstall)
            uninstall_multi_report
            ;;
    esac
    
    # Check if we need sudo elevation first
    check_and_elevate "$@"
    
    # Parse options
    local debug=false
    local config_file=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --version|-v)
                show_version
                exit 0
                ;;
            --debug)
                debug=true
                shift
                ;;
            --config)
                config_file="$2"
                shift 2
                ;;
            auto|status|test|report|config)
                command="$1"
                shift
                break
                ;;
            *)
                # Check if it's a plugin command
                if [ -n "$1" ] && plugin_exists "$1" 2>/dev/null; then
                    command="$1"
                    shift
                    break
                fi
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done
    
    # Initialize logging now (after we know it's not just --help or --version)
    init_logging
    
    # Enable debug if requested
    if [ "$debug" = true ]; then
        set_log_level "debug"
        log_debug "Debug mode enabled"
    fi
    
    # Initialize application
    if ! init_app; then
        log_error "Initialization failed"
        exit 1
    fi
    
    # Execute command
    case "${command:-status}" in
        auto)
            cmd_auto
            ;;
        status)
            cmd_status
            ;;
        test)
            cmd_test
            ;;
        report)
            cmd_report
            ;;
        config)
            cmd_config "$@"
            ;;
        *)
            # Check if it's a plugin command
            if plugin_exists "$command"; then
                execute_plugin "$command" "$@"
            else
                log_error "Unknown command: $command"
                exit 1
            fi
            ;;
    esac
    
    log_info "$(get_full_version) completed successfully"
    exit 0
}

# Run main
main "$@"
